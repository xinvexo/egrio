    "egrio-service": ["egrio-core", "egrio-platform", "egrio-platform-linux", "egrio-platform-macos", "egrio-platform-windows", "egrio-runtime"],
    "egrio-sdk": ["egrio-core", "egrio-runtime", "egrio-service", "egrio-platform-linux", "egrio-platform-macos", "egrio-platform-windows"],
    "egrio-daemon": ["egrio-core", "egrio-runtime", "egrio-sdk", "egrio-platform", "egrio-platform-linux", "egrio-platform-macos", "egrio-platform-windows"],
    "egrio-platform": ["egrio-core"],
